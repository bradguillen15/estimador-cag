  "cards": [
    {
      "dot": "amber",
      "title": "Request pipeline",
      "items": [
        "get_safe_request runs guardrails before the handler or SSE starts",
        "Then exact cache, semantic cache, LLM, output check, store",
        "A cache hit skips the LLM; SSE done event carries cache_hit",
        "Only answers that pass the output check are stored"
      ]
    },
    {
      "dot": "cyan",
      "title": "Prompt assembly (CAG)",
      "items": [
        "v3 system.j2: static rules + examples.j2 prefix",
        "Then request.j2 (detail, format) and language.j2",
        "user.j2 wraps the description in project_description tags",
        "System prompt cached per version, detail, format, language"
      ]
    },
    {
      "dot": "rose",
      "title": "Input guardrails",
      "items": [
        "Prompt-injection heuristics (EN + ES) reject with InputRejectedError",
        "Emails, phones and IBANs are redacted, never rejected",
        "Moderation is opt-in (MODERATION_ENABLED) and fails open",
        "Rejection is an HTTP 400 on both endpoints"
      ]
    },
    {
      "dot": "emerald",
      "title": "Response caches (opt-in)",
      "items": [
        "Exact cache: Redis key over sanitized request, prompt version, models",
        "Semantic cache: redisvl on Redis Stack, bucketed, cosine threshold",
        "Semantic log_only (default) logs would-be hits without serving them",
        "Disabled or unreachable Redis becomes a no-op or a miss"
      ]
    },
    {
      "dot": "violet",
      "title": "LLM routing (LiteLLM)",
      "items": [
        "LLM_MODELS is ordered: first model is primary",
        "A failed call falls back to the next model",
        "Streams fall back only before the first chunk",
        "Anthropic caches the system prompt prefix"
      ]
    },
    {
      "dot": "slate",
      "title": "Endpoints and errors",
      "items": [
        "POST /estimate returns JSON; /estimate/stream sends SSE token and done",
        "GET /context returns the CAG examples for the UI",
        "InputRejectedError 400, UnknownPromptVersionError 422, PromptTemplateError 500, LLMProviderError 502",
        "Stream failures become an SSE error event; description is 20 to 20000 chars"
      ]
    }
  ]
}
